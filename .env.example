# Copia estos nombres a tu proveedor de despliegue. No pongas secretos reales aquí.
PORT=3000
NODE_ENV=production
DATA_DIR=/var/data
BOT_TOKEN=
WEBAPP_URL=https://tu-servicio.onrender.com
SERVER_SECRET_KEY=
ADMIN_AUDIT_TOKEN=
ADSGRAM_WEBHOOK_SECRET=
TRUST_PROXY=true
ALLOWED_ORIGINS=
ENABLE_LEGACY_WAGER_API=false
ALLOW_INSECURE_DEV_AUTH=false
# Interruptores operativos v105 (valores seguros por defecto)
ECONOMY_ACTIONS_ENABLED=true
TON_PURCHASES_ENABLED=true
# Dentro de Telegram, los bienes digitales se cobran con Stars; mantener en false.
TELEGRAM_TON_PURCHASES_ENABLED=false
# Requiere BOT_TOKEN en el mismo servicio que crea la factura y en el bot que
# procesa pre_checkout_query/successful_payment sobre la misma base de datos.
TELEGRAM_STARS_PURCHASES_ENABLED=true
# Registro global y preparación de conversión NFT. Preparar no acuña.
NFT_ENTITLEMENTS_ENABLED=true
# Mantener false hasta contrato probado en testnet, wallet verificada con
# ton_proof, colección configurada y metadatos permanentes.
TON_NFT_MINTING_ENABLED=false
# No activar hasta completar escrow/liquidación o mercado transaccional en servidor.
ENABLE_WAGER_STAKES=false
ENABLE_MARKETPLACE=false
ENABLE_WEEKLY_TOURNAMENT=false
ENABLE_REFERRAL_REWARDS=true
ENABLE_AD_REWARDS=true
# Cuentas internas/de equipo: IDs numéricos de Telegram separados por comas.
# Una sola vez por cuenta se completa el catálogo, se maximizan los coches y
# se sube el saldo hasta 100.000 $CR sin borrar el progreso existente. Dejar
# vacío en despliegues públicos que no necesiten cuentas de equipo.
TEAM_BOOTSTRAP_TELEGRAM_IDS=
# Soporte público opcional (se muestra en /api/config y en la página de soporte)
SUPPORT_CONTACT=
SUPPORT_URL=
# Copias SQLite automáticas dentro del directorio persistente
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=/var/data/apex_backups
DB_BACKUP_INTERVAL_HOURS=6
DB_BACKUP_RETENTION=14
# Tesorería oficial que recibe los pagos TON de paquetes $CR (dirección pública).
TREASURY_WALLET_ADDRESS=UQD4ivLM7PJ7XpX_CflUUhoZW361xvOH4WP869C9WghJAN4X
# Opcionales pero recomendadas: claves de indexadores para verificar pagos
# sin límites estrictos de la API pública (toncenter.com / tonapi.io).
TONCENTER_API_KEY=
TONAPI_KEY=
# Opcional: deja vacío para usar la cotización TON/USDT en directo.
# Solo fijar un número si el operador decide bloquear temporalmente el tipo
# de cambio (también lo usan las pruebas locales para ser deterministas).
TON_USDT_RATE_OVERRIDE=
# Base NFT TON v105: todavía sin colección desplegada. No rellenar la
# colección ni activar minting hasta completar la validación en testnet.
TON_NFT_NETWORK=ton-testnet
TON_NFT_COLLECTION_ADDRESS=
TON_NFT_COLLECTION_OWNER_ADDRESS=
TON_NFT_ROYALTY_ADDRESS=
TON_NFT_CLAIM_AMOUNT_NANOTONS=40000000
TON_NFT_ITEM_RESERVE_NANOTONS=15000000
TON_NFT_COLLECTION_RESERVE_NANOTONS=5000000
TON_NFT_METADATA_BASE_URL=
# Solo para mocks locales fuera de producción. En producción se fuerza
# https://api.telegram.org y esta variable no debe definirse.
TELEGRAM_BOT_API_BASE_URL=
